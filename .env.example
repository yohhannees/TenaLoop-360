DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tenaloop?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_COOKIE_NAME="tenaloop_session"
AUTH_SESSION_DAYS="30"
AUTH_CODE_MINUTES="10"
APP_URL="http://localhost:3000"

# SMTP settings for Nodemailer passwordless login codes.
# When SMTP_HOST is omitted, auth emails are written to the server console for local demos.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TenaLoop 360 <no-reply@tenaloop.local>"

# Optional AI provider settings for /api/coach.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
